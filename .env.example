# Plantilla de configuración. Copia este archivo como ".env" (que Git ignora) y escribe ahí los valores REALES.
# NUNCA escribas claves reales en este archivo: este SÍ se sube a GitHub.
PRINT24_DATABASE=data/catalog.sqlite3

# WooCommerce de La Imprenta de Internet, clave de SOLO LECTURA.
# Se crea en: WooCommerce > Ajustes > Avanzado > API REST > Añadir clave > Permisos: Solo lectura.
# Las dos claves de abajo son de ejemplo y no funcionan: cámbialas en el ".env" de cada PC.
WOO_URL=https://laimprentadeinternet.com
WOO_KEY=ck_pega_aqui_la_clave_de_cliente
WOO_SECRET=cs_pega_aqui_el_secreto_de_cliente
